// A header's items that UIKit has no object of its own for (LLP 1141.004,
// BarHostedIOSTests): link items, which follow their `href`; a row of a
// label and a switch, and a readout that holds a Retry button, each hosted,
// whose entries in UIKit's overflow menu do what the element does.
routes nav
  home "/"
    history "/history"
      about "/history/about"

component BarHosted
  state live = false
  state retried = 0
  action follow(url: string)
    nav = go(nav, url)
  action flip(on: bool)
    live = on
  action retry
    retried = retried + 1
  view
    main navigationKey=`${top(nav).id}` navigate=follow width="100%" height="100%"
      for e in stack(nav) key=e.id
        column navigationKey=`${e.id}` position="absolute" inset=0
          header display="flex" align-items="center"
            text (e.name == "home" ? "Inbox" : e.name == "history" ? "History" : "About") role="heading" aria-level=2 flex=1
            if e.name == "home"
              link href="/history" aria-label="History" testId="history-link"
                image "symbol:history" width=20 height=20
              row gap=6 align-items="center" testId="live-row"
                text "Live" font-size=13
                input type="checkbox" role="switch" checked=live change=flip aria-label="Live" testId="live-switch"
              row role="status" aria-label=`Offline, retried ${retried}` gap=6 align-items="center" testId="offline"
                text "Offline" font-size=13
                button press=retry aria-label="Retry" testId="retry"
                  text "Retry"
            if e.name == "history"
              link href="/history/about" aria-label="About" testId="about-link"
                image "symbol:info" width=20 height=20
          text (live ? "on" : "off") testId="live"
          text `${retried}` testId="retried"
