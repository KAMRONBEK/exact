use PaneViewport, paneDirection from "./arrangement.contract"

// The Arrangement screen: a UIKit app's arrangement screen (one navigation
// controller, a route whose `UIArrangementViewController` holds two scrolling
// panes) written in Contract. The Layout menu picks UIKit's split or overlay
// arrangement through the `arranged-panes` hatch. The Options menus set the
// route's navigation item and bar scroll view through the route hatch: title
// display, bar minimization, the safe-area adjustment and the content scroll
// view, a pane found through the `arrangement-pane` element hatch. Next pushes
// another screen with the same settings. Hosts without
// UIArrangementViewController show the panes in CSS and only Next.

shape ArrangementSettings
  layout: string
  titleDisplay: string
  barMinimization: string
  safeAreaAdjustment: string
  contentScroll: string

// A row's number as the UIKit app prints it (`%03d`)
fn rowNumber(n: number): string = n < 10 ? `00${n}` : n < 100 ? `0${n}` : `${n}`

component ArrangementView
  props
    routeKey: string
    depth: number
    native: bool
    seed: ArrangementSettings
    openNext: action
    back: action
  resource viewport = exactViewport() as shape PaneViewport
  // Each screen keeps its own settings, starting from those the last Next carried
  state settings = seed
  // A screen's depth is the number in its location (`/arrangement/3` is 3; the tab's root is 1),
  // so its title, Next and testIds agree with the URL however the screen was opened. The ids the
  // hosts resolve (menus, panes) carry the visit's key, which stays unique in the stack when two
  // screens share a depth
  derive key = `arrangement-${routeKey}`
  derive prefix = `arrangement-${depth}`
  derive title = depth == 1 ? "Arrangement" : `Arrangement ${depth}`
  derive across = viewport.horizontalViewportSegments == 2
  derive down = viewport.verticalViewportSegments == 2
  // Without UIKit's arrangement a fold puts each pane on its own segment and the header in the first pane, so
  // the panes' container starts at the viewport's origin, which segments are measured from (docs/recipes/foldables.md)
  derive anchored = not native and (across or down)
  action layout(value: string)
    settings = ArrangementSettings(settings, layout=value)
  action titleDisplay(value: string)
    settings = ArrangementSettings(settings, titleDisplay=value)
  action barMinimization(value: string)
    settings = ArrangementSettings(settings, barMinimization=value)
  action safeAreaAdjustment(value: string)
    settings = ArrangementSettings(settings, safeAreaAdjustment=value)
  action contentScroll(value: string)
    settings = ArrangementSettings(settings, contentScroll=value)
  view
    column navigationKey=routeKey navigationBar=(anchored ? "none" : "auto") testId=`${prefix}-screen` data-title-display=settings.titleDisplay data-bar-minimization=settings.barMinimization data-safe-area-adjustment=settings.safeAreaAdjustment data-content-scroll=(settings.contentScroll == "automatic" ? "" : `${key}-${settings.contentScroll}`) position="absolute" inset=0
      if not anchored
        ArrangementHeader(title=title, prefix=prefix, menus=key, native=native, pushed=false, openNext=openNext(settings, depth + 1), back=back)
      if native
        column id=`${key}-layout` popover="auto" role="menu" position="absolute"
          Choice(menu=`${key}-layout`, group=`${prefix}-layout`, label="Split Automatic", value="split", chosen=settings.layout, choose=layout)
          Choice(menu=`${key}-layout`, group=`${prefix}-layout`, label="Split Horizontal", value="horizontal", chosen=settings.layout, choose=layout)
          Choice(menu=`${key}-layout`, group=`${prefix}-layout`, label="Split Vertical", value="vertical", chosen=settings.layout, choose=layout)
          Choice(menu=`${key}-layout`, group=`${prefix}-layout`, label="Overlay", value="overlay", chosen=settings.layout, choose=layout)
        column id=`${key}-options` popover="auto" role="menu" position="absolute"
          Submenu(label="Content Scroll View", menu=`${key}-content-scroll`, name=`${prefix}-content-scroll`)
          Submenu(label="Title Display", menu=`${key}-title-display`, name=`${prefix}-title-display`)
          Submenu(label="Bar Minimization", menu=`${key}-bar-minimization`, name=`${prefix}-bar-minimization`)
          Submenu(label="Safe Area Adjustment", menu=`${key}-safe-area`, name=`${prefix}-safe-area`)
        column id=`${key}-content-scroll` popover="auto" role="menu" position="absolute" position-area="right span-bottom" aria-label="Content Scroll View"
          Choice(menu=`${key}-options`, group=`${prefix}-content-scroll`, label="Automatic", value="automatic", chosen=settings.contentScroll, choose=contentScroll)
          Choice(menu=`${key}-options`, group=`${prefix}-content-scroll`, label="Primary", value="primary", chosen=settings.contentScroll, choose=contentScroll)
          Choice(menu=`${key}-options`, group=`${prefix}-content-scroll`, label="Secondary", value="secondary", chosen=settings.contentScroll, choose=contentScroll)
        column id=`${key}-title-display` popover="auto" role="menu" position="absolute" position-area="right span-bottom" aria-label="Title Display"
          Choice(menu=`${key}-options`, group=`${prefix}-title-display`, label="Automatic", value="automatic", chosen=settings.titleDisplay, choose=titleDisplay)
          Choice(menu=`${key}-options`, group=`${prefix}-title-display`, label="Inline", value="inline", chosen=settings.titleDisplay, choose=titleDisplay)
          Choice(menu=`${key}-options`, group=`${prefix}-title-display`, label="Large", value="large", chosen=settings.titleDisplay, choose=titleDisplay)
        column id=`${key}-bar-minimization` popover="auto" role="menu" position="absolute" position-area="right span-bottom" aria-label="Bar Minimization"
          Choice(menu=`${key}-options`, group=`${prefix}-bar-minimization`, label="Automatic", value="automatic", chosen=settings.barMinimization, choose=barMinimization)
          Choice(menu=`${key}-options`, group=`${prefix}-bar-minimization`, label="Never", value="never", chosen=settings.barMinimization, choose=barMinimization)
          Choice(menu=`${key}-options`, group=`${prefix}-bar-minimization`, label="On Scroll Down", value="on-scroll-down", chosen=settings.barMinimization, choose=barMinimization)
          Choice(menu=`${key}-options`, group=`${prefix}-bar-minimization`, label="On Scroll Up", value="on-scroll-up", chosen=settings.barMinimization, choose=barMinimization)
        column id=`${key}-safe-area` popover="auto" role="menu" position="absolute" position-area="right span-bottom" aria-label="Safe Area Adjustment"
          Choice(menu=`${key}-options`, group=`${prefix}-safe-area`, label="Automatic", value="automatic", chosen=settings.safeAreaAdjustment, choose=safeAreaAdjustment)
          Choice(menu=`${key}-options`, group=`${prefix}-safe-area`, label="Enabled", value="enabled", chosen=settings.safeAreaAdjustment, choose=safeAreaAdjustment)
          Choice(menu=`${key}-options`, group=`${prefix}-safe-area`, label="Disabled", value="disabled", chosen=settings.safeAreaAdjustment, choose=safeAreaAdjustment)
      // UIKit lays out the two panes where it supports arrangements; elsewhere CSS puts them side by side or stacked
      column hatch="arranged-panes" data-pane-layout=(native ? settings.layout : "css") testId=`${prefix}-container` flex=1 min-height=0 position="relative" flex-direction=(anchored ? "column" : paneDirection(viewport))
        ArrangementPane(id=`${key}-primary`, name=`${prefix}-primary`, label="Primary", ground="pane.primary", stripe="pane.primary.stripe", band="pane.primary.band", anchored=anchored, leading=true, across=across, down=down)
          if anchored
            ArrangementHeader(title=title, prefix=prefix, menus=key, native=native, pushed=depth > 1, openNext=openNext(settings, depth + 1), back=back)
        ArrangementPane(id=`${key}-secondary`, name=`${prefix}-secondary`, label="Secondary", ground="pane.secondary", stripe="pane.secondary.stripe", band="pane.secondary.band", anchored=anchored, leading=false, across=across, down=down)

// The screen's header: UIKit's navigation bar where it is the route's first child. The Layout and Options
// buttons open the menus the route declares beside it. In a pane it draws the Back a pushed screen's bar
// would (docs/recipes/foldables.md).
component ArrangementHeader
  props
    title: string
    prefix: string
    menus: string
    native: bool
    pushed: bool
    openNext: action
    back: action
  view
    header display="flex" align-items="center" gap=8 padding="8px 16px"
      if pushed
        button press=back testId=`${prefix}-back`
          text "Back"
      text title role="heading" aria-level=2 flex=1 testId=`${prefix}-title`
      if native
        button popovertarget=`${menus}-layout` aria-label="Layout" testId=`${prefix}-layout-button`
          image "symbol:icon.split"
        button popovertarget=`${menus}-options` aria-label="Options" testId=`${prefix}-options-button`
          image "symbol:more"
      button press=openNext aria-label="Next" testId=`${prefix}-next`
        image "symbol:icon.next"

// One single-choice row of a menu: the current choice is checked
component Choice
  props
    menu: string
    group: string
    label: string
    value: string
    chosen: string
    choose: action
  view
    button press=choose(value) role="menuitemradio" aria-checked=(chosen == value) popovertarget=menu popovertargetaction="hide" testId=`${group}-${value}`
      text label

// A row of the Options menu that opens one of its submenus
component Submenu
  props
    label: string
    menu: string
    name: string
  view
    button popovertarget=menu role="menuitem" aria-haspopup="menu" testId=`${name}-opener`
      text label
      text "›" aria-hidden=true

component ArrangementPane
  props
    id: string
    name: string
    label: string
    ground: string
    stripe: string
    band: string
    anchored: bool
    leading: bool
    across: bool
    down: bool
  slot
  // On a segment, placed from the container's origin as the Panes screen's panes are. Across a fold each pane
  // is as wide as the narrower segment: the primary aligns to the container's start, the secondary to its end,
  // so in a right-to-left screen the primary takes the right segment. Down a fold the primary fills the upper
  // segment, and the secondary runs from the top of the lower one to the container's end.
  derive width = anchored and across ? "min(env(viewport-segment-width 0 0), env(viewport-segment-width 1 0))" : (anchored ? "auto" : "100%")
  derive height = anchored and down and leading ? "env(viewport-segment-height 0 0)" : (anchored ? "auto" : "100%")
  derive top = not anchored ? "auto" : (down and not leading ? "env(viewport-segment-top 0 1)" : "0px")
  derive side = anchored and down ? "0px" : "auto"
  derive bottom = anchored and not (down and leading) ? "0px" : "auto"
  view
    // Off a fold, fill UIKit's allocation (the pane's containing block) or the CSS row, to scroll within it
    scroll id=id hatch="arrangement-pane" testId=name flex="1 1 0%" width=width height=height min-width=0 min-height=0 position=(anchored ? "absolute" : "relative") top=top left=side right=side bottom=bottom align-self=(anchored and across ? (leading ? "flex-start" : "flex-end") : "auto") background-color=ground
      children
      for i in range(150) key=i
        column gap=4 padding="16px 20px" background-color=((i + 1) % 2 == 0 ? stripe : band) testId=`${name}-row-${i + 1}`
          text `${label} ${rowNumber(i + 1)}` font="-exact-body"
          text "Scroll this pane independently." font="-exact-subheadline" color="-exact-secondary-label"
