{
  "name": "exact-contract",
  "displayName": "Exact Contract",
  "description": "Syntax highlighting (Contract + Forma), snippets, problem matcher, TypeScript 7 content-mapper registration, and Language Server (LSP 3.17) for Exact Contract files.",
  "version": "0.5.0",
  "private": true,
  "publisher": "exact",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:exact-contract"
  ],
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "exact-contract",
        "aliases": [
          "Exact Contract",
          "Contract"
        ],
        "extensions": [
          ".contract"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "exact-forma",
        "aliases": [
          "Exact Forma",
          "Forma"
        ],
        "extensions": [
          ".forma"
        ],
        "configuration": "./forma-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "exact-contract",
        "scopeName": "source.exact-contract",
        "path": "./syntaxes/exact-contract.tmLanguage.json"
      },
      {
        "language": "exact-forma",
        "scopeName": "source.exact-forma",
        "path": "./syntaxes/exact-forma.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "exact-contract",
        "path": "./snippets/exact-contract.code-snippets"
      }
    ],
    "commands": [
      {
        "command": "exactContract.restartServer",
        "title": "Exact Contract: Restart Language Server"
      },
      {
        "command": "exactContract.fixUses",
        "title": "Exact Contract: Add Missing `use` Imports"
      },
      {
        "command": "exactContract.applyQuickFixes",
        "title": "Exact Contract: Apply All Deterministic Quick Fixes"
      },
      {
        "command": "exactContract.lookupVocab",
        "title": "Exact Contract: Look Up or Search Vocabulary"
      },
      {
        "command": "exactContract.showOutline",
        "title": "Exact Contract: Show Structural Outline (JSON)"
      },
      {
        "command": "exactContract.checkSeam",
        "title": "Exact Contract: Audit App Seam (Data, Strings, Tokens, Manifest)"
      },
      {
        "command": "exactContract.showImpact",
        "title": "Exact Contract: Analyze Symbol Blast Radius"
      }
    ],
    "configuration": {
      "title": "Exact Contract",
      "properties": {
        "exactContract.compiler": {
          "type": "string",
          "scope": "machine-overridable",
          "markdownDescription": "The Contract compiler, `contract`, by its path. When set, **Format Document** on a `.contract` file runs `contract fmt --stdin` on the editor's text, and each open contract's warnings show as problems, compiled again as it changes. Unset, no formatter is registered and nothing is run."
        },
        "exactContract.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to the `contract` compiler executable for `contract lsp --stdio`. When empty, falls back to `exactContract.compiler`, workspace `target/{host-dev,release,debug}/contract`, `exact.mjs`, or `contract` on PATH."
        },
        "exactContract.server.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional arguments passed to `contract lsp --stdio`."
        },
        "exactContract.inlayHints.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show inferred type and action-write inlay hints."
        },
        "exactContract.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show reference counts and inferred action writes as CodeLens annotations."
        },
        "exactContract.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace communication with the Exact Contract language server in the Output panel."
        }
      }
    },
    "problemMatchers": [
      {
        "name": "exact-contract",
        "label": "Exact Contract compiler",
        "owner": "exact-contract",
        "source": "contract",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "severity": "error",
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+) (?:(warning) )?\\[([a-z0-9-]+)\\] (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      }
    ]
  },
  "files": [
    "README.md",
    "extension.js",
    "language-configuration.json",
    "forma-language-configuration.json",
    "syntaxes/*.json",
    "snippets/*.code-snippets",
    "src/*.js"
  ]
}
